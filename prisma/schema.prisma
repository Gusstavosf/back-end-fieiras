generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cabinet {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  Fieira Fieira[]
}

model Fieira {
  id                    Int      @id @default(autoincrement())
  cabinetId             Int?     @unique
  width                 Decimal  @db.Decimal(10, 2)
  thickness             Decimal  @db.Decimal(10, 2)
  nominalFieiraCapacity Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now())

  // Relations
  Cabinet       Cabinet?        @relation(fields: [cabinetId], references: [id])
  ControlFieira ControlFieira[]
  StockFieira   StockFieira[]
  Requisitions  Requisition[]

  @@unique([width, thickness])
}

model ControlFieira {
  id              Int           @id @default(autoincrement())
  order           Int
  orderQuantity   Decimal       @db.Decimal(10, 3)
  material        Int
  wireType        String
  metal           Metal
  tension         Int
  width           Decimal       @db.Decimal(10, 2)
  thickness       Decimal       @db.Decimal(10, 2)
  fieiraId        Int
  orderStartDate  DateTime
  orderEndDate    DateTime
  orderCreateDate DateTime
  status          ControlStatus
  qtdFieiraNec    Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())

  // Relations
  Fieira              Fieira               @relation(fields: [fieiraId], references: [id])
  ReservationFieira   ReservationFieira[]
  requisitionControls RequisitionControl[]
}

model StockFieira {
  id               Int          @id @default(autoincrement())
  fieiraId         Int
  code             String
  status           StatusFieira
  currentThickness Decimal?     @db.Decimal(10, 2)
  currentWidth     Decimal?     @db.Decimal(10, 2)
  utilization      Int          @default(0)
  production       Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now())

  // Relations
  Fieira            Fieira               @relation(fields: [fieiraId], references: [id])
  RequisitionItems  RequisitionItem[]
  ReservationFieira ReservationFieira[]
  History           StockFieiraHistory[]

  @@unique([fieiraId, code])
}

model Requisition {
  id              Int      @id @default(autoincrement())
  fieiraId        Int
  currentStockQty Int
  requisitionQty  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  // Relations
  Fieira              Fieira               @relation(fields: [fieiraId], references: [id])
  RequisitionItems    RequisitionItem[]
  requisitionControls RequisitionControl[]
}

model RequisitionItem {
  id            Int @id @default(autoincrement())
  requisitionId Int
  fieiraId      Int

  // Relations
  StockFieira StockFieira @relation(fields: [fieiraId], references: [id])
  Requisition Requisition @relation(fields: [requisitionId], references: [id])

  @@unique([requisitionId, fieiraId])
}

model RequisitionControl {
  id              Int @id @default(autoincrement())
  requisitionId   Int
  controlFieiraId Int

  Requisition   Requisition   @relation(fields: [requisitionId], references: [id])
  ControlFieira ControlFieira @relation(fields: [controlFieiraId], references: [id])

  @@unique([requisitionId, controlFieiraId])
}

model ReservationFieira {
  id        Int @id @default(autoincrement())
  controlId Int
  fieiraId  Int

  // Relations
  StockFieira   StockFieira   @relation(fields: [fieiraId], references: [id])
  ControlFieira ControlFieira @relation(fields: [controlId], references: [id])

  @@unique([controlId, fieiraId])
}

model StockFieiraHistory {
  id            Int          @id @default(autoincrement())
  stockFieiraId Int
  status        StatusFieira
  thickness     Decimal?     @db.Decimal(10, 2)
  width         Decimal?     @db.Decimal(10, 2)
  utilization   Int          @default(0)
  production    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  StockFieira StockFieira @relation(fields: [stockFieiraId], references: [id], onDelete: Cascade)

  @@map("StockFieiraHistory")
}

model SupplierFieiraStock {
  id           Int      @id @default(autoincrement())
  thickness    Decimal? @db.Decimal(10, 2)
  width        Decimal? @db.Decimal(10, 2)
  quantitySent Int
  quantityUsed Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
}

enum StatusFieira {
  new
  requested
  dead
  polished
}

enum Metal {
  cu
  al
}

enum ControlStatus {
  open
  released_printed
  released_not_printed
  completed
  canceled
}
